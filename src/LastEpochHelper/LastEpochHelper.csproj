<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK target gives access to the built-in OCR (Windows.Media.Ocr). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon and screen capture; see the Using Remove items below. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.7.17</Version>
    <!-- The manifest is how a WPF app declares DPI awareness; the WinForms analyzer does not apply. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Their type names (Application, Brush, Color, ...) clash with WPF's; use them fully qualified. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shown in the app's "What's new" window. -->
    <Content Include="..\..\CHANGELOG.md" Link="Data\CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LastEpochHelper.Tests" />
  </ItemGroup>

  <!--
    Where "Report a bug" sends to. The address is a secret of sorts, so it is not in this repository:
    it is read from report-endpoint.local.txt in the repository root (ignored by git) when that file
    exists, and built into the program. Without the file, reports are saved to the desktop instead.
  -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\report-endpoint.local.txt')">
    <ReportEndpoint>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\report-endpoint.local.txt').Trim())</ReportEndpoint>
  </PropertyGroup>
  <ItemGroup Condition="'$(ReportEndpoint)' != ''">
    <AssemblyMetadata Include="ReportEndpoint" Value="$(ReportEndpoint)" />
  </ItemGroup>

  <!-- Where the country code goes (see Core/UsagePing.cs); kept out of the repository the same way. Without the file nothing is sent. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\usage-endpoint.local.txt')">
    <UsageEndpoint>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\usage-endpoint.local.txt').Trim())</UsageEndpoint>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsageEndpoint)' != ''">
    <AssemblyMetadata Include="UsageEndpoint" Value="$(UsageEndpoint)" />
  </ItemGroup>

</Project>
